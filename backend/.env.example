# Copie ce fichier en ".env" en local pour tester, mais sur Render mets ces
# valeurs dans Settings > Environment (jamais dans un fichier commité).
GROQ_API_KEY=colle_ta_cle_groq_ici
GEMINI_API_KEY=colle_ta_cle_gemini_ici

# Optionnel : un mot de passe simple que ton app Android enverra dans le header
# x-app-secret, pour que seule ton app puisse utiliser ton backend.
APP_SHARED_SECRET=choisis_un_secret_ici
